+    static func installReceivedFile(at url: URL, to destination: URL) -> Bool {
+        let staged = destination.deletingLastPathComponent().appendingPathComponent(".incoming-" + UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: staged) }
+        do { try FileManager.default.copyItem(at: url, to: staged) }
+        catch { return false }
+        // POSIX rename replaces the destination atomically on the same volume.
+        // The old file is untouched if either the copy or rename fails.
+        return rename(staged.path, destination.path) == 0
